{
  "name": "schetovod",
  "version": "1.0.0",
  "private": true,
  "description": "Счетовод — Сервис для выставления счетов на оплату (SaaS)",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "db:generate": "cd server && npm run db:generate",
    "db:migrate": "cd server && npm run db:migrate",
    "db:push": "cd server && npm run db:push",
    "db:seed": "curl -X POST http://localhost:3000/api/billing/seed-plans",
    "desktop:install": "cd desktop && npm install",
    "desktop:dev": "cd desktop && npm start",
    "desktop:build": "cd desktop && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
